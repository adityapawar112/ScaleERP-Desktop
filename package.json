{
  "name": "scaleerp",
  "version": "0.1.0",
  "description": "ScaleERP Inventory Management Desktop Application",
  "main": "build-electron/main.js",
  "homepage": "./",
  "private": true,
  "dependencies": {
    "@types/jspdf": "^1.3.3",
    "@types/sqlite3": "^3.1.11",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.1",
    "chart.js": "^4.5.1",
    "crypto-js": "^4.2.0",
    "ctx7": "^0.3.9",
    "electron-log": "^5.2.4",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.7",
    "node-cron": "^4.2.1",
    "react": "^19.2.0",
    "react-bootstrap": "^2.8.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.4",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.5",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-license-keys": "node vendor/generate-license-keys.cjs",
    "generate-license": "node vendor/generate-license.cjs",
    "create-user": "node vendor/create-user.cjs",
    "generate-reset-code": "node vendor/generate-reset-code.cjs",
    "validate-license-phase1": "node scripts/validate-license-phase1.cjs",
    "validate-license-phase2": "node scripts/validate-license-phase2.cjs",
    "validate-license-phase5-auth-foundation": "node scripts/validate-license-phase5-auth-foundation.cjs",
    "validate-license-phase5-auth-integration": "node scripts/validate-license-phase5-auth-integration.cjs",
    "validate-password-reset": "npx tsx scripts/validate-password-reset.ts",
    "electron": "npm run build-electron && npm run copy-schema && electron build-electron/main.js",
    "electron-dev": "concurrently \"npm run dev\" \"npm run build-electron-watch\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron build-electron/main.js\"",
    "build-electron": "tsc -p electron/tsconfig.json",
    "build-electron-watch": "tsc -p electron/tsconfig.json --watch",
    "build-electron-complete": "npm run build-electron && npm run copy-schema && node scripts/obfuscate-main.cjs",
    "copy-schema": "copy electron\\database\\schema.sql build-electron\\database\\",
    "build-all": "npm run build && npm run build-electron-complete && node scripts/verify-build-safety.cjs",
    "build-electron-dist": "cross-env NODE_ENV=production npm run build-all && cross-env NODE_ENV=production electron-builder",
    "build-electron-win": "cross-env NODE_ENV=production npm run build-all && cross-env NODE_ENV=production electron-builder --win",
    "dist": "npm run build-electron-dist"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.0.12",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "javascript-obfuscator": "^5.4.1",
    "jsdom": "^29.1.1",
    "nock": "^14.0.15",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.scaleerp.inventory",
    "productName": "ScaleERP",
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "build/**/*",
      "build-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScaleERP"
    },
    "mac": {
      "icon": "public/brand/app-icon-squircle-green.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "public/brand/app-icon-squircle-green.png",
      "target": "AppImage"
    },
    "protocols": {
      "name": "ScaleERP Protocol",
      "schemes": [
        "scaleerp"
      ]
    }
  }
}
